{
  "expo": {
    "name": "Turquz",
    "slug": "Turquz",
    "scheme": "turquz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5d338e85-b28e-4fb7-84f6-80afc00ebb54",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turquz.app",
      "buildNumber": "11",
      "infoPlist": {
        "NSCameraUsageDescription": "Görüntülü mülakat için kameraya erişim gerekir.",
        "NSMicrophoneUsageDescription": "Görüntülü mülakat için mikrofona erişim gerekir.",
        "NSPhotoLibraryUsageDescription": "Pasaport ve belge yüklemek için galeriye erişim gerekir.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bitcode": false
    },
    "android": {
      "package": "com.turquz.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#1b2533",
          "sounds": [
            "./assets/sounds/notify.wav"
          ]
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-camera",
        {
          "cameraPermission": "Pasaport fotoğrafını çekmek için kameraya erişim gerekir."
        }
      ],
      "react-native-document-scanner-plugin",
      "react-native-compressor",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "5d338e85-b28e-4fb7-84f6-80afc00ebb54"
      }
    },
    "owner": "kurtoglutunc"
  }
}
